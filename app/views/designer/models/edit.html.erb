<% content_for :title, "#{@model.title} — Printwright designer" %>
<h1><%= @model.title %>
  <span class="badge <%= @model.published? ? "badge-ok" : "badge-pending" %>"><%= @model.status %></span>
</h1>
<% if @model.file_hash.present? %>
  <p class="mono t-small">bundle <%= @model.file_hash.truncate(28) %></p>
<% end %>
<%= render "form", model: @model %>

<% unless @model.draft? %>
  <section class="section-stack">
    <h2>Listing availability</h2>
    <% if @model.published? %>
      <p class="t-small">Live in discovery and available for new purchases. Pausing is temporary;
        retiring removes it from sale until you explicitly restore it.</p>
      <div class="field-row">
        <%= button_to "Pause new sales", pause_designer_model_path(@model), method: :patch,
              class: "btn", form: { data: { turbo_confirm: "Pause discovery and all new checkout? Existing buyer rights and downloads will remain available." } } %>
        <%= button_to "Retire listing", retire_designer_model_path(@model), method: :patch,
              class: "btn", form: { data: { turbo_confirm: "Retire this listing? It will keep a public status page and preserve every existing buyer right." } } %>
      </div>
    <% elsif @model.paused? %>
      <p class="t-small">New discovery and checkout are paused. The public status page and every
        existing receipt, certificate, entitled download, and model update remain available.</p>
      <div class="field-row">
        <%= button_to "Resume new sales", resume_designer_model_path(@model), method: :patch,
              class: "btn btn-primary" %>
        <%= button_to "Retire listing", retire_designer_model_path(@model), method: :patch,
              class: "btn", form: { data: { turbo_confirm: "Retire this listing? Existing buyer rights remain available." } } %>
      </div>
    <% else %>
      <p class="t-small">Retired from discovery and new checkout. Historical buyer rights remain
        available. Restoring returns it to a paused state, never directly to live sales.</p>
      <%= button_to "Restore as paused", restore_designer_model_path(@model), method: :patch,
            class: "btn" %>
    <% end %>
  </section>

  <section class="section-stack">
    <h2>File updates for existing buyers</h2>
    <p class="t-small">Paid x402 license holders can fetch the newest version. The original certified bundle stays unchanged, including while sales are paused or retired.</p>
    <% unless @model.retired? %>
      <%= form_with url: designer_model_versions_path(@model), scope: :model_version, multipart: true do |form| %>
        <div class="field">
          <%= form.label :file, "Printable file (STL, 3MF, or STEP)" %>
          <%= form.file_field :file, accept: ".stl,.3mf,.step", required: true %>
        </div>
        <div class="field">
          <%= form.label :changelog %>
          <%= form.text_area :changelog, rows: 3, required: true %>
        </div>
        <%= form.submit "Publish update", class: "btn btn-primary" %>
      <% end %>
    <% end %>

    <% if @model.model_versions.any? %>
      <h3>Version history</h3>
      <ul>
        <% @model.model_versions.reverse_each do |version| %>
          <li>v<%= version.number %> — <%= version.changelog %>
            <% status = version.mesh_failed? ? "void" : (version.deliverable? ? "settled" : "pending") %>
            <%= render "shared/state", state: status,
                  label: case version.mesh_analysis_status
                         when "passed", "skipped" then "Delivered to buyers"
                         when "failed" then "Validation failed — buyers keep the previous version"
                         else "Validating" end %>
            <% if version.mesh_failed? && version.mesh_analysis_errors.any? %>
              <span class="t-small muted"><%= version.mesh_analysis_errors.join("; ") %></span>
            <% end %>
            <span class="mono t-small"><%= version.anchored? ? "HCS ##{version.hcs_sequence_number}" : "HCS pending" %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
