<% content_for :title, "Notifications — Printwright designer" %>

<header class="page-heading-row">
  <div>
    <p class="card-taxonomy">Workspace</p>
    <h1>Notifications</h1>
    <p>Sales, certificates, payouts, payout destination changes, webhook health, mesh analysis, and identity
      checks — never buyer identity, wallet signatures, or receipt/download capabilities.</p>
  </div>
  <% if @notifications.any?(&:unread?) %>
    <%= button_to "Mark all read", mark_all_read_designer_notifications_path, method: :patch, class: "btn" %>
  <% end %>
</header>

<% if @notifications.any? %>
  <ol class="home-activity">
    <% @notifications.each do |notification| %>
      <li>
        <span>
          <small>
            <% if notification.unread? %><span class="badge badge-pending">Unread</span><% end %>
            <time datetime="<%= notification.created_at.utc.iso8601 %>">
              <%= time_ago_in_words(notification.created_at) %> ago · <%= notification.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
            </time>
          </small>
          <% link = notification_link(notification) %>
          <% if link %>
            <%= link_to notification_title(notification), link.last %>
          <% else %>
            <strong><%= notification_title(notification) %></strong>
          <% end %>
          <span><%= notification_detail(notification) %></span>
        </span>
      </li>
    <% end %>
  </ol>
  <% if @notifications.size == Designer::NotificationsController::RECENT_LIMIT %>
    <p class="t-small muted">Showing the most recent <%= Designer::NotificationsController::RECENT_LIMIT %>.</p>
  <% end %>
<% else %>
  <div class="empty-state">
    <p><strong>No notifications yet.</strong> Sales, certificates, payouts, webhook health, mesh analysis, and
      identity checks will appear here as they happen.</p>
  </div>
<% end %>

<section id="notification-email-preferences" class="section-block"
  aria-labelledby="notification-email-preferences-title">
  <h2 id="notification-email-preferences-title">Email preferences</h2>
  <%= form_with model: current_designer, scope: :designer,
        url: email_preferences_designer_notifications_path, method: :patch do |form| %>
    <p><label><%= form.check_box :email_on_sale %> Email me each delivered sale</label></p>
    <p><label><%= form.check_box :email_on_payout_issue %> Email me when a payout fails or needs reconciliation</label></p>
    <p class="t-small muted">Security notices — payout destination changes and account access — always go to
      your verified email and cannot be turned off. In-product notifications are always kept.</p>
    <%= form.submit "Save email preferences", class: "btn" %>
  <% end %>
</section>
