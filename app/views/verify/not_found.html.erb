<% content_for :title, "Certificate not found — Printwright" %>
<% requested = params[:cert_id].to_s %>
<div class="verify-page">
  <div class="verify-banner banner-bad"><strong>Certificate not found</strong></div>
  <% if requested.match?(License::CERT_ID_FORMAT) %>
    <%# The licence text tells buyers to keep their cert_id, so pasting it here
        is the expected mistake. It is the right proof under the wrong handle:
        this page is keyed by a separate private token. %>
    <p class="muted"><span class="mono"><%= requested %></span> is a certificate id, not a verify token.
      This page is reached by the <strong>verify link on your receipt</strong>, which ends in a
      different, private token — the one that lets you choose who sees the certificate.
      Open that link rather than pasting the certificate id.</p>
    <p class="muted">The certificate id is the handle for the proof bundle instead:
      <span class="mono">GET /api/v1/certificates/<%= requested %></span> returns the same
      certificate, nonce and anchor this page shows.</p>
  <% else %>
    <p class="muted">No certificate with id <span class="mono"><%= requested %></span> exists here.
      Check the verify link on your receipt, or browse the
      <a href="<%= Hedera::Network.hashscan_base %>/topic/<%= ENV.fetch("HEDERA_HCS_TOPIC_ID", "0.0.9585069") %>">public certificate topic</a>.</p>
  <% end %>
</div>
