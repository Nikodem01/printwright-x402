<% content_for :title, "#{@designer.display_name} — Printwright" %>
<div class="designer-page">
  <% if @designer.account_closed? %>
    <% content_for :head do %><meta name="robots" content="noindex"><% end %>
    <h1><%= @designer.display_name %></h1>
    <div class="empty-state">
      <h2>Designer account closed</h2>
      <p>This studio no longer sells on Printwright. Existing licenses, transaction-time terms,
        receipts, certificates, downloads, and model-version rights remain valid.</p>
    </div>
  <% else %>
  <h1><%= @designer.display_name %><% if @designer.identity_verified? %> <%= render "designers/verified_mark" %><% end %></h1>
  <% if @designer.identity_verified? %>
    <p class="t-small"><%= link_to "Verified public profile", verified_profile_designer_path(@designer),
          target: "_blank", rel: "noopener" %></p>
  <% end %>
  <% if @designer.bio.present? %>
    <div class="prose"><%= simple_format(@designer.bio) %></div>
  <% end %>
  <%# Payment readiness is a platform state; the destination account id is
      the studio's private financial detail, never published here. %>
  <% if @designer.payout_account_verified? %>
    <p class="t-small muted">Verified Hedera payout destination — the account id stays private to the studio.</p>
  <% end %>

  <% if @models.any? %>
    <h2 style="margin-top: var(--s6)"><%= pluralize(@models.size, "published model") %></h2>
    <div class="card-grid">
      <%= render partial: "storefront/model_card", collection: @models, as: :model %>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No published models yet</h2>
      <p><%= @designer.display_name %> hasn't published any models yet — check back soon.</p>
    </div>
  <% end %>
  <% end %>
</div>
